# QA environment (the default — `pytest` with no ENV set uses this file).
#
# Committed, so keep real secrets out of it. Anything here can be overridden
# by your own .env or by a real environment variable in CI.

# Web app
BASE_URL=https://qa.creditrepaircloud.com

# CRC platform APIs
CRC_API_BASE_URL=https://qa-api.creditrepaircloud.com
AUTH_API_BASE_URL=https://qa-auth-migration.creditrepaircloud.com
OAUTH_BASE_URL=https://qa-oauth.creditrepaircloud.com

# CloudMail services (internal hosts — need VPN)
CLOUDMAIL_LETTERS_BASE_URL=http://qa-cloudmail-letters.internal.creditrepaircloud.com
CLOUDMAIL_BASE_URL=http://qa-cloudmail.internal.creditrepaircloud.com

# Public signup funnels
LEADS_BASE_URL=https://amex4516.qa-leads-new.getcredithelpnow.com
HOUSEHOLD_LEADS_BASE_URL=https://hplan.qa-leads-new.getcredithelpnow.com
SCA_BASE_URL=https://staging.secureclientaccess.com

# Test accounts. These are the values that were previously hardcoded in
# settings.py — move them to your .env and delete them here once rotated.
CRC_EMAIL=pm@yopmail.com
CRC_PASSWORD=Test@1234
CRC_PDF_USER_EMAIL=pdf@yopmail.com
CRC_PDF_USER_PASSWORD=P@ssw0rd
CRC_CLIENTS_EMAIL=tollysystem@testmail.creditrepaircloud.com
CRC_CLIENTS_PASSWORD=P@ssw0rd12345

# ── Rate-limit probes (tests/api/rate_limit) ──────────────────────
# Records these probes act on in this environment.
RATE_LIMIT_CLIENT_ID=52
RATE_LIMIT_AFFILIATE_ID=3
# How many calls per endpoint.
RATE_LIMIT_N_TIMES=101
RATE_LIMIT_IMPORT_N_TIMES=3
# Short-lived tokens — put the real values in .env, they expire within a day.
RATE_LIMIT_BEARER_TOKEN=
RATE_LIMIT_TEAM_MEMBER_TOKEN=
RATE_LIMIT_OAUTH_TOKEN=
