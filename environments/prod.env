# Production:  ENV=prod pytest
#
# Hosts from the old test_rate_limit_prod.py. Treat this profile as
# read-only-ish: anything that creates records runs against real customer
# infrastructure. Credentials are deliberately blank — supply them in .env or
# CI for the specific run, so prod is never the accidental default.

# Web app
BASE_URL=https://app.creditrepaircloud.com

# CRC platform APIs
CRC_API_BASE_URL=https://api.creditrepaircloud.com
AUTH_API_BASE_URL=https://prod-auth-migration.creditrepaircloud.com
OAUTH_BASE_URL=https://oauth.creditrepaircloud.com

# CloudMail services — prod hosts not confirmed
CLOUDMAIL_LETTERS_BASE_URL=
CLOUDMAIL_BASE_URL=

# Public signup funnels — prod tenants not confirmed
LEADS_BASE_URL=
HOUSEHOLD_LEADS_BASE_URL=
SCA_BASE_URL=

# Never commit production credentials. Supply them per run.
CRC_EMAIL=
CRC_PASSWORD=
CRC_PDF_USER_EMAIL=
CRC_PDF_USER_PASSWORD=
CRC_CLIENTS_EMAIL=
CRC_CLIENTS_PASSWORD=

TEAM_MEMBER_TOKEN=
