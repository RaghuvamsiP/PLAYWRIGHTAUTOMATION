# Stage environment:  ENV=stage pytest
#
# The API hosts are taken from the old test_rate_limit_stage.py. Values left
# blank are ones I could not confirm — a test that needs one fails with a
# message naming this file rather than silently hitting the wrong host.

# Web app
BASE_URL=https://stage.creditrepaircloud.com

# CRC platform APIs
CRC_API_BASE_URL=https://stage-api.creditrepaircloud.com
AUTH_API_BASE_URL=https://stage-auth-migration.creditrepaircloud.com
OAUTH_BASE_URL=https://stage-oauth.creditrepaircloud.com

# CloudMail services — stage hosts not confirmed
CLOUDMAIL_LETTERS_BASE_URL=
CLOUDMAIL_BASE_URL=

# Public signup funnels — stage tenants not confirmed
LEADS_BASE_URL=
HOUSEHOLD_LEADS_BASE_URL=
SCA_BASE_URL=

# Test accounts — set these in your .env, they are not the QA ones.
CRC_EMAIL=
CRC_PASSWORD=
CRC_PDF_USER_EMAIL=
CRC_PDF_USER_PASSWORD=
CRC_CLIENTS_EMAIL=
CRC_CLIENTS_PASSWORD=

# ── Rate-limit probes (tests/api/rate_limit) ──────────────────────
# Records these probes act on in this environment.
RATE_LIMIT_CLIENT_ID=5
RATE_LIMIT_AFFILIATE_ID=2
# How many calls per endpoint.
RATE_LIMIT_N_TIMES=6
RATE_LIMIT_IMPORT_N_TIMES=6
# Short-lived tokens — put the real values in .env, they expire within a day.
RATE_LIMIT_BEARER_TOKEN=
RATE_LIMIT_TEAM_MEMBER_TOKEN=
RATE_LIMIT_OAUTH_TOKEN=
