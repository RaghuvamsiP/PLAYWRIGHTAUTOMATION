# Copy to `.env` (git-ignored) for your personal overrides.
#
# Precedence, first hit wins:
#   1. a real environment variable (CI)
#   2. .env                        <- this file, once copied
#   3. environments/<ENV>.env      <- the committed profile
#   4. the fallback in settings.py
#
# So anything you put here overrides the committed profile for every
# environment, which is what you want for secrets and personal accounts.

# Which profile to load: qa (default), stage, prod.
# Usually left unset here and passed per run instead: ENV=stage pytest
# ENV=qa

# Run without a visible browser.
# HEADLESS=1

# Credentials — keep real ones here, not in environments/*.env
# CRC_EMAIL=
# CRC_PASSWORD=
# CRC_CLIENTS_EMAIL=
# CRC_CLIENTS_PASSWORD=
# CRC_SUPPORT_EMAIL=
# CRC_SUPPORT_PASSWORD=
# CRC_PDF_USER_EMAIL=
# CRC_PDF_USER_PASSWORD=

# Short-lived tokens for the rate-limit probes. Refresh from DevTools when
# they start returning 401.
# RATE_LIMIT_BEARER_TOKEN=
# RATE_LIMIT_TEAM_MEMBER_TOKEN=
# RATE_LIMIT_OAUTH_TOKEN=

# Point a single service somewhere else without editing a profile.
# CRC_API_BASE_URL=https://qa-api.creditrepaircloud.com

# Input for the credential-sweep test.
# CHS_CSV_PATH=
